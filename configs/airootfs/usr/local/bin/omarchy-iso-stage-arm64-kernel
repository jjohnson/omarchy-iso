#!/bin/bash

set -e

source_image=/boot/Image
staged_image=/boot/vmlinuz-linux-aarch64
preset_source=/usr/share/omarchy-iso/linux-aarch64.preset
preset_target=/etc/mkinitcpio.d/linux-aarch64.preset

if [[ ! -f $source_image ]]; then
  echo "Error: linux-aarch64 did not install $source_image" >&2
  exit 1
fi

install -Dm644 "$source_image" "$staged_image"
install -Dm644 "$preset_source" "$preset_target"

# The build profile masks the stock package hook so it cannot build host-style
# images before this Archiso preset is staged. Remove the mask from the live
# environment before generating the one image the ISO actually boots.
rm -f /etc/pacman.d/hooks/90-mkinitcpio-install.hook
mkinitcpio -p linux-aarch64

# Keep the live /boot payload limited to Archiso's staged kernel and initramfs.
rm -f /boot/initramfs-linux.img /boot/initramfs-linux-fallback.img
